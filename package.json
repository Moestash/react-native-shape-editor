{
  "name": "react-native-shape-editor",
  "version": "3.0.1",
  "description": "Touch-driven SVG shape and note editing for React Native",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "react-native": "src/index.js",
  "types": "index.d.ts",
  "files": [
    "src",
    "!src/**/__tests__/**",
    "dist",
    "index.d.ts",
    "example/NotesEditor.js",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "test": "jest --watch",
    "test:once": "jest --runInBand",
    "lint": "eslint src example",
    "typecheck": "tsc --noEmit -p test-config/tsconfig.json",
    "prepublishOnly": "npm run lint && npm run test:once && npm run typecheck && npm run clean && npm run build && npm run test:bundle",
    "test:bundle": "node scripts/test-native-bundle.js",
    "prepare": "npm run clean && npm run build"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.78.0",
    "react-native-svg": ">=15.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.28.0",
    "@eslint/js": "^9.39.0",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/metro-config": "^0.88.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@types/react": "^19.2.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-test-renderer": "19.3.1",
    "rollup": "^4.53.0",
    "typescript": "^5.9.0",
    "metro": "0.87.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.spec.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test-config/test-setup.js"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/test-config/react-native.js",
      "^react-native-svg$": "<rootDir>/test-config/react-native-svg.js",
      "^react-native-shape-editor$": "<rootDir>/src/index.js"
    },
    "watchman": false
  },
  "keywords": [
    "react-native",
    "svg",
    "shape-editor",
    "notes",
    "annotations",
    "drawing",
    "resize",
    "rotation"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
